# Copy to /etc/fblink-backup/backup.env on the production VDS.

RESTIC_REPOSITORY=rest:https://srv.frakebit.com/fblink
RESTIC_PASSWORD_FILE=/etc/fblink-backup/restic-password
RESTIC_REST_USERNAME=fblink-vds
RESTIC_REST_PASSWORD_FILE=/etc/fblink-backup/rest-server-password
BACKUP_RECEIVER_HOST=srv.frakebit.com

BACKEND_CONTAINER=vpn-backend
BACKEND_DB_PATH=/app/data/vpn.db
BACKEND_DOWNLOADS_PATH=/app/data/downloads

COMPOSE_DIR=/opt/fblink/vpn-backend
CADDYFILE_PATH=/opt/fblink/Caddyfile

# Space-separated host paths to include if they exist.
EXTRA_PATHS="/opt/fblink/certs /opt/fblink/deploy"

LOCK_FILE=/var/lock/fblink-backup.lock
WORK_ROOT=/var/tmp/fblink-backup
