{
	# Global options
	servers {
		protocols h1 h2 h3
	}
}


# System Domain (Telegram bot, Webhooks, API, VPN Backend, Admin Panel)
fblink-sc.com, www.fblink-sc.com {
	log {
		output stdout
		format json
	}

	# FBLink VPN Go backend: REST API, TV device flow, downloads.
	@vpn_backend {
		path /api/v1/* /tv /tv/* /download* /admin /admin/*
	}

	handle @vpn_backend {
		reverse_proxy vpn_backend:8081 {
			header_up Host {host}
			header_up X-Real-IP {remote}
		}
	}

	# FBLink VPN Next.js frontend: personal cabinet, Next API routes, and the new AAA admin panel.
	@vpn_frontend {
		path /api /api/* /auth /auth/* /dashboard /dashboard/* /_next/* /favicon.ico /brand-icon.png /legal/* /apple-icon.png /icon*
	}

	handle @vpn_frontend {
		reverse_proxy fblink-web:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
	
	handle {
		reverse_proxy fblink-web:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}

}

